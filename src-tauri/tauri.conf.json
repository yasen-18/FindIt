{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FindIt",
  "mainBinaryName": "FindIt",
  "identifier": "app.findit.search",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FindIt",
        "width": 1180,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "FindIt contributors",
    "copyright": "Copyright (c) 2026 FindIt contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "Instant file search for Windows",
    "longDescription": "FindIt finds any file or folder on your PC as you type. Local only: no accounts, no telemetry.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
